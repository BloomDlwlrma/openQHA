% =======================================================================================
% Branch B -- the methods this branch's numbers actually rest on.
%
% Added 2026-09-04, when branch B moved from a Langevin thermostat to a Nose-Hoover chain
% and gained a second production route through OpenMM. Every entry below is cited by name
% somewhere in openqha/ or scripts/, and the ones that fix a NUMBER say which number.
% =======================================================================================

% ---- Quasi-harmonic analysis ----------------------------------------------------------

% The estimator itself: entropy from the eigenvalues of the mass-weighted covariance of
% atomic fluctuations. openqha/qha.py implements eq. 6 and eq. 7.
% Also the source of the convergence warning branch B inherited: on their Lennard-Jones
% test 200 ps was NOT converged and about 4 ns were needed. openQHA's acceptance
% criterion 1 is that statement made checkable.
@article{andricioaei2001,
	title = {On the calculation of entropy from covariance matrices of the atomic
	         fluctuations},
	author = {Andricioaei, Ioan and Karplus, Martin},
	journal = {The Journal of Chemical Physics},
	volume = {115},
	number = {14},
	pages = {6289--6292},
	year = {2001},
	doi = {10.1063/1.1401821},
}

% The upper bound used as a free implementation check: S_QH <= S_Schlitter is analytic,
% so a violation is an implementation error rather than a physical result.
@article{schlitter1993,
	title = {Estimation of absolute and relative entropies of macromolecules using the
	         covariance matrix},
	author = {Schlitter, J{\"u}rgen},
	journal = {Chemical Physics Letters},
	volume = {215},
	number = {6},
	pages = {617--621},
	year = {1993},
	doi = {10.1016/0009-2614(93)89366-P},
}

% The protocol branch B follows: superimpose every frame, then take the covariance;
% translational and rotational contributions are neglected and added back analytically.
% ALSO the source of branch B's 50/ps coupling -- "a friction coefficient of 50 ps-1 was
% employed for each atom", and "a piston collision frequency of 50 ps-1" -- and of the
% equilibration warning: 20 ps was planned, 520 ps was necessary.
@article{rinaldo2003,
	title = {A computational study of the open and closed forms of the {N}-lobe human
	         serum transferrin apo-protein},
	author = {Rinaldo, Danielle and Field, Martin J.},
	journal = {Biophysical Journal},
	volume = {85},
	number = {6},
	pages = {3485--3501},
	year = {2003},
	doi = {10.1016/S0006-3495(03)74769-9},
}

% The first use of a quasi-harmonic covariance to get configurational entropy.
@article{karplus1981,
	title = {Method for estimating the configurational entropy of macromolecules},
	author = {Karplus, Martin and Kushick, Joseph N.},
	journal = {Macromolecules},
	volume = {14},
	number = {2},
	pages = {325--332},
	year = {1981},
	doi = {10.1021/ma50003a019},
}

% ---- The thermostat --------------------------------------------------------------------

% Why a CHAIN and not plain Nose-Hoover. The harmonic oscillator is the case where plain
% Nose-Hoover is not ergodic, which is precisely the regime a 10-atom molecule near its
% minimum sits in -- measured here as a configurational variance ratio of 2.591 against a
% canonical value of 1. GROMACS with the default leap-frog integrator SILENTLY reduces the
% chain to length 1, so this reference is also why configs/mdp/s0_qha_production.mdp
% specifies integrator = md-vv.
@article{martyna1992,
	title = {Nos{\'e}--{H}oover chains: The canonical ensemble via continuous dynamics},
	author = {Martyna, Glenn J. and Klein, Michael L. and Tuckerman, Mark},
	journal = {The Journal of Chemical Physics},
	volume = {97},
	number = {4},
	pages = {2635--2643},
	year = {1992},
	doi = {10.1063/1.463940},
}

% The reversible multiple-time-step / Yoshida-Suzuki chain propagation that ASE and
% OpenMM both implement, and whose ORDER turned out to matter: ASE is hard-wired to a
% 3-term decomposition, OpenMM defaults to 7, and at the same coupling time the measured
% bias differed by a factor of four (-1.15 against -0.31 kcal/mol on T*S).
@article{martyna1996,
	title = {Explicit reversible integrators for extended systems dynamics},
	author = {Martyna, Glenn J. and Tuckerman, Mark E. and Tobias, Douglas J. and
	          Klein, Michael L.},
	journal = {Molecular Physics},
	volume = {87},
	number = {5},
	pages = {1117--1157},
	year = {1996},
	doi = {10.1080/00268979600100761},
}

